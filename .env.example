# Copy this file to .env and fill in real values. Never commit the real .env.

# Flask secret key for CTFd. This is ALSO the key used to derive every player's
# unique flag, so keep it stable for the whole event. Rotating it invalidates
# every flag that has already been issued.
SECRET_KEY=change_me_to_a_long_random_string

# Shared bearer token between CTFd and the instancer control plane. CTFd sends
# it as the X-Auth-Token header on every instancer call.
INSTANCER_TOKEN=change_me_to_another_long_random_string

# Generate strong values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Optional. Hard cap on live instances across all players (default 100). Each
# instance gets its own Docker network, so raising this past ~30 also needs the
# address-pool change in docker/daemon.json.example (see docs/02-setup.md).
# MAX_GLOBAL_INSTANCES=100
